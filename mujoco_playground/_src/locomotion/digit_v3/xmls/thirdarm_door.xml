<mujoco model="shelf">
    <worldbody>
    <!-- Door frame (fixed in the world) - rotated 90 degrees -->
    <body name="door_frame" pos="2 0.2 1" euler="0 0 -90">
      <!-- Left post -->
      <geom name="frame_left"
            type="box"
            size="0.05 0.1 2.1"
            pos="-0.8 0 0"
            rgba="0.6 0.6 0.6 1"
           />
      
      <!-- Right post -->
      <geom name="frame_right"
            type="box"
            size="0.05 0.1 2.1"
            pos="0.8 0 0"
            rgba="0.6 0.6 0.6 1"
            />
      
      <!-- Top cross-bar -->
      <geom name="frame_top"
            type="box"
            size="0.8 0.1 0.05"
            pos="0 0 2.15"
            rgba="0.6 0.6 0.6 1"
            />

      <!-- Hinged door (child of frame) -->
      <body name="door" pos="-0.75 0 0">
        <!-- Hinge joint - positioned at the left edge of the door -->
        <joint name="door_hinge"
               type="hinge"
               pos="0 0 0"
               axis="0 0 1"
               limited="true"
               range="0 120"
               damping="0.1"
               frictionloss="0.1"
               stiffness="0.1"/>
        
        <!-- Door panel - properly sized and positioned -->
        <geom name="door_panel"
              type="box"
              size="0.75 0.05 2.1"
              pos="0.75 0 0"
              rgba="0.7 0.4 0.1 1"
              contype="1"
              conaffinity="2"
              density="300"
              friction="0.8 0.1 0.1"/>
        
        
      </body>

    </body>

  </worldbody>
</mujoco>